# ---- 云端（下一里程碑接入）----
CLOUD_API_BASE_URL=https://<你的腾讯云网站域名>/api/internal/agent
AGENT_ID=office-4070super-01
AGENT_API_TOKEN=change-me

# ---- Ollama（运行在宿主机）----
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3-vl:8b
TEXT_MODEL=qwen2.5:7b-instruct   # 纯文本任务模型（无图片时使用；未配置时回退 OLLAMA_MODEL）
EMBEDDING_MODEL=bge-m3:latest
LLM_CACHE_ENABLED=true           # 需求级 LLM 结果缓存（SQLite，相同输入直接复用）
LLM_THINK=false                  # 关闭 qwen3 思考链（提速关键，单次调用可省 30%+）
LLM_MAX_TOKENS=4096              # 单次结构化输出 token 上限，防输出失控

# ---- Qdrant（向量库，RAG 阶段启用）----
QDRANT_HOST=host.docker.internal
QDRANT_PORT=6333
EMBEDDING_MODEL=bge-m3:latest

# ---- Worker ----
WORK_DIR=./data/incoming
SQLITE_PATH=./data/agent.db
LOG_LEVEL=INFO
RAG_ENABLED=false
PRICING_MODE=ai_quote   # ai_quote=AI 报价方法（原型：LLM 估工时，代码按 50元/h 算价）；qrs=QRS 规则模板引擎
